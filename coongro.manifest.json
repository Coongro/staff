{
  "id": "staff",
  "version": "0.2.0",
  "apiVersion": "2.0",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [],
    "views": [],
    "repositories": [
      {
        "module": "./dist/repositories/staff-member.repository.js",
        "export": "StaffMemberRepository",
        "prefix": "staff.members",
        "actions": [
          "list",
          "getById",
          "create",
          "update",
          "delete",
          "search",
          "findByLicenseNumber",
          "findByContactId",
          "getByUser",
          "getCurrent",
          "linkUser",
          "unlinkUser",
          "listUsers"
        ]
      }
    ],
    "permissions": [
      {
        "id": "staff.members.read",
        "label": "Ver empleados",
        "description": "Consultar el equipo del negocio: nombres, datos de contacto y roles.",
        "effect": "read",
        "grants": {
          "actions": [
            "staff.members.findByContactId",
            "staff.members.findByLicenseNumber",
            "staff.members.getById",
            "staff.members.getByUser",
            "staff.members.getCurrent",
            "staff.members.list",
            "staff.members.search"
          ]
        }
      },
      {
        "id": "staff.members.manage",
        "label": "Gestionar empleados",
        "description": "Dar de alta y editar empleados, y vincular cada uno con su usuario del sistema.",
        "effect": "write",
        "grants": {
          "actions": [
            "staff.members.create",
            "staff.members.linkUser",
            "staff.members.listUsers",
            "staff.members.unlinkUser",
            "staff.members.update"
          ]
        },
        "requires": ["staff.members.read"]
      },
      {
        "id": "staff.members.delete",
        "label": "Eliminar empleados",
        "description": "Dar de baja empleados del negocio.",
        "effect": "destructive",
        "grants": { "actions": ["staff.members.delete"] },
        "requires": ["staff.members.read"]
      }
    ]
  }
}
